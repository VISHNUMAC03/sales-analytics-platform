# Copy this file to ".env" and change values if you need to.
# The project works without a .env file - these are all optional.

# Where the DuckDB warehouse file lives
# WAREHOUSE_PATH=warehouse/sales.duckdb

# Exchange-rate API (free, no key needed)
# FX_API_URL=https://api.frankfurter.app/latest

# Optional: also upload raw files to Amazon S3.
# Needs an AWS account and credentials (aws configure). Leave empty to stay local.
# S3_BUCKET=my-sales-raw-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
